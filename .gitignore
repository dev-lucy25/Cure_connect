# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: 절대 커밋 금지. 실제 키는 로컬 .env 와 배포 환경변수(Vercel)에만 둔다.
# .env.example 은 값이 빈 항목 목록만 커밋한다.
.env*
*.env
!.env.example

# prisma client (generated)
/generated/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
