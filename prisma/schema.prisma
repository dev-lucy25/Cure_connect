generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  student
  professor
}

// Supabase Auth 사용자(auth.users)와 1:1. id는 Supabase 사용자 id를 그대로 쓴다.
// 역할은 서버만 정한다: 가입 시 항상 student, professor는 시드 스크립트로만 생성.
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String   @db.VarChar(30)
  role      Role     @default(student)
  // 졸업 목표 실습 시간 (사용자가 바꿀 수 있음)
  goalHours Int      @default(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  practiceLogs      PracticeLog[]
  practiceSchedules PracticeSchedule[]
  caseNotes         CaseNote[]
  aiUsages          AiUsage[]

  @@index([role])
}

// 케이스 메모와 AI 정리 결과(SOAPIE·간호진단·빠진 사정 항목).
// memoUpdatedAt > aiAt 이면 메모가 정리 뒤에 바뀐 것 → "다시 정리" 표시
model CaseNote {
  id            String    @id @default(cuid())
  userId        String    @db.Uuid
  title         String    @db.VarChar(60)
  ward          String    @db.VarChar(60)
  memo          String    @db.VarChar(2000)
  memoUpdatedAt DateTime  @default(now())
  aiResult      Json?
  aiAt          DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 내 케이스를 최근 수정순으로 나눠 읽는다
  @@index([userId, updatedAt(sort: Desc), id(sort: Desc)])
}

// AI 정리 하루 사용 횟수 (1인 하루 20회). day는 한국 날짜
model AiUsage {
  userId String @db.Uuid
  day    DateTime @db.Date
  count  Int    @default(0)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

// 실습 일지. 시간은 소수 오차가 없도록 분 단위 정수로 저장한다 (화면은 0.5시간 단위).
model PracticeLog {
  id         String   @id @default(cuid())
  userId     String   @db.Uuid
  date       DateTime @db.Date
  hospital   String   @db.VarChar(60)
  ward       String   @db.VarChar(60)
  minutes    Int
  activities String   @db.VarChar(2000)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 내 일지를 최신 날짜순으로 나눠 읽는다
  @@index([userId, date(sort: Desc), id(sort: Desc)])
}

// 다음 실습 일정 → "내과병동 실습 D-5"
model PracticeSchedule {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  hospital  String   @db.VarChar(60)
  ward      String   @db.VarChar(60)
  startDate DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 다가오는 일정을 시작일순으로 찾는다
  @@index([userId, startDate])
}
