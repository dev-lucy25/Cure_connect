# 이 파일은 항목 목록만 담는다. 값은 절대 여기 쓰지 말 것.
# 이 파일을 .env 로 복사해 값을 채운다 (.env 는 git이 무시함). 배포 서버에는 Vercel 환경변수로 넣는다.
# 코드에서는 lib/env/public.ts, lib/env/server.ts 로만 읽는다 (ESLint가 다른 곳의 직접 읽기를 막음).

# Supabase (Project Settings → API). 브라우저 공개용 값만 NEXT_PUBLIC_ 사용
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. 시드 스크립트에서만 사용 (NEXT_PUBLIC_ 금지)
SUPABASE_SERVICE_ROLE_KEY=

# 시드로 만드는 가짜 테스트 계정들의 공통 비밀번호 (8자 이상)
SEED_USER_PASSWORD=

# Prisma (Project Settings → Database → Connection string)
# 앱 실행용: Transaction pooler (포트 6543)
DATABASE_URL=
# 마이그레이션용: Session pooler 또는 Direct (포트 5432)
DIRECT_URL=


# Gemini API (서버 전용, NEXT_PUBLIC_ 금지)
GEMINI_API_KEY=
