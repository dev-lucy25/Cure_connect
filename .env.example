# Supabase (Project Settings → API). 브라우저 공개용 값만 NEXT_PUBLIC_ 사용
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. 시드 스크립트에서만 사용 (NEXT_PUBLIC_ 금지)
SUPABASE_SERVICE_ROLE_KEY=

# 시드로 만드는 가짜 테스트 계정들의 공통 비밀번호 (8자 이상)
SEED_USER_PASSWORD=

# Prisma (Project Settings → Database → Connection string)
# 앱 실행용: Transaction pooler (포트 6543)
DATABASE_URL=
# 마이그레이션용: Session pooler 또는 Direct (포트 5432)
DIRECT_URL=

# Claude API (서버 전용, NEXT_PUBLIC_ 금지)
ANTHROPIC_API_KEY=
